# MongoDB Configuration
MONGODB_URI=
DATABASE_NAME=
COLLECTION_NAME=subtitles

# LibreTranslate languages to load (comma-separated ISO 639-1 codes)
LT_LANGUAGES=en,zh,hi,es,fr,ar,bn,pt,ru,ja,de,ko,it,nl,pl,tr,vi,th,id,uk,sv,cs,el,hu,fi,da,ro,he,fa,tl,ms,bg,nb,ur

# LibreTranslate port (host side)
LT_PORT=5000

# Subtitle API port
API_PORT=3300
